# MaterialIQ — environment configuration (placeholders only; never commit real values)
#
# Copy to .env.local and fill in ONLY what you need. .env.local is git-ignored.

# ── Database dialect ─────────────────────────────────────────────────────────
# sqlite (default) | postgres | postgresql
# The application ALWAYS defaults to SQLite (data/materialiq.db). Set this to
# postgres ONLY for Supabase integration testing — never in normal dev config.
MATERIALIQ_DB_DIALECT=sqlite

# ── PostgreSQL / Supabase connection (server-side only; never client-side) ──
# Get this from Supabase → Project Settings → Database → Connection string.
# Use the session pooler URI for IPv4 networks. Replace [YOUR-PASSWORD] and
# keep the whole value OUT of git, logs, screenshots and client bundles.
# Example shape only:
# MATERIALIQ_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MATERIALIQ_DATABASE_URL=

# ── Existing optional configuration (unchanged) ─────────────────────────────
# PORT=63000
# REQUIRE_AUTH=true
# DATA_DIR=./data
# DB_PATH=./data/materialiq.db

# ── PostgreSQL TLS (Step 10) ─────────────────────────────────────────────────
# CA-pinned sslmode=verify-full is the DEFAULT: the executor loads
# certs/supabase-ca.crt (pinned once via `npx tsx scripts/bootstrap-pg-ca.ts`)
# and enforces CA + hostname verification on every connection. This flag only
# exists for offline experiments — leave unset in every real environment.
# MATERIALIQ_PG_SSL=insecure

# ── Import upload caps (Step 12) ─────────────────────────────────────────────
# Per-format limits. CSV is parsed incrementally through the bounded streaming
# pipeline and chunked import jobs; XLSX parsing materializes the whole
# workbook (memory-sensitive) and keeps a conservative safety cap. If the
# legacy MAX_IMPORT_FILE_MB is set it overrides BOTH for compatibility.
IMPORT_MAX_CSV_MB=50
IMPORT_MAX_XLSX_MB=5
# MAX_IMPORT_FILE_MB=5
